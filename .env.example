# ═══════════════════════════════════════════════════════════════════════════════
# Database Configuration
# ═══════════════════════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://coderunner:password@localhost:5432/coderunner
REDIS_URL=redis://localhost:6379/0

# ═══════════════════════════════════════════════════════════════════════════════
# Security & Authentication
# ═══════════════════════════════════════════════════════════════════════════════
JWT_SECRET=super_secret_key_change_in_production_must_be_32_bytes_minimum!!!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

API_KEY_SECRET=another_super_secret_key_for_api_key_hashing_change_me!!!

# ═══════════════════════════════════════════════════════════════════════════════
# SafePay Payment Integration
# Get your keys from: https://getsafepay.pk/dashboard
# ═══════════════════════════════════════════════════════════════════════════════
SAFEPAY_API_KEY=sec_your_safepay_api_key_here
SAFEPAY_WEBHOOK_SECRET=your_webhook_secret_here
SAFEPAY_ENVIRONMENT=sandbox   # sandbox | production

# ═══════════════════════════════════════════════════════════════════════════════
# Docker Sandbox Execution
# ═══════════════════════════════════════════════════════════════════════════════
DOCKER_BASE_URL=
DEFAULT_EXECUTION_TIMEOUT=10
DEFAULT_MEMORY_LIMIT=128m
DEFAULT_CPU_QUOTA=50000
DEFAULT_PIDS_LIMIT=64
MAX_SOURCE_CODE_SIZE_BYTES=65536
MAX_OUTPUT_SIZE_BYTES=131072

# ═══════════════════════════════════════════════════════════════════════════════
# CORS Configuration
# ═══════════════════════════════════════════════════════════════════════════════
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:3000

# ═══════════════════════════════════════════════════════════════════════════════
# Application Settings
# ═══════════════════════════════════════════════════════════════════════════════
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME=CodeRunner Cloud
